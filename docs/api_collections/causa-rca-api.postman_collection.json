              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/diagnostics/stats",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "diagnostics", "stats"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"total\": 2,\n  \"inProgress\": 0,\n  \"healthy\": 0,\n  \"completed\": 2,\n  \"failed\": 0\n}"
            }
          ]
        },
        {
          "name": "List Diagnostic Issues (Summary)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/diagnostics/issues?verbose=false&page=0&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "diagnostics", "issues"],
              "query": [
                {
                  "key": "verbose",
                  "value": "false"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "pageSize",
                  "value": "50"
                }
              ]
            },
            "description": "Lists analyses that identified issues (unhealthy pods). Returns summary by default."
          },
          "response": []
        },
        {
          "name": "List Diagnostic Issues (Verbose)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/diagnostics/issues?verbose=true&page=0&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "diagnostics", "issues"],
              "query": [
                {
                  "key": "verbose",
                  "value": "true"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            },
            "description": "Lists analyses that identified issues with complete details."
          },
          "response": []
        },
        {
          "name": "List All Workloads",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/workloads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "workloads"]
            },
            "description": "Lists all Kubernetes pods across all namespaces with their status and restart counts."
          },
          "response": []
        }
      ],
      "description": "Endpoints for querying analysis results and monitoring system status"
    }
  ],
  "auth": {
    "type": "noauth"
  },
